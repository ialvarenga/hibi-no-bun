# Chave da API da Anthropic — usada apenas no servidor (função /api/generate).
# NUNCA prefixe com VITE_, ou ela seria embutida no bundle do frontend e exposta.
ANTHROPIC_API_KEY=sk-ant-...

# String de conexão do banco — usada só no servidor (funções /api/generate e
# /api/shared) para os parágrafos compartilhados.
#
# Local (Docker, veja docker-compose.yml): rode `npm run db:up` e use:
DATABASE_URL=postgres://hibi:hibi@localhost:5432/hibi_no_ichibun
#
# Produção: ao linkar um banco Postgres (Neon) na Vercel, rode `vercel env
# pull` para preencher esse valor automaticamente em vez de digitá-lo à mão.

# --- Painel de feedback (dono) ---
# Senha única do dono para acessar o painel em /?admin. É comparada em tempo
# constante no servidor e nunca chega ao cliente (só o cookie de sessão chega).
ADMIN_PASSWORD=troque-esta-senha
# Segredo usado para assinar (HMAC) o cookie de sessão do painel. Use um valor
# longo e aleatório; girar este valor invalida todas as sessões abertas.
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# --- Notificação de feedback por e-mail (opcional) ---
# Sem RESEND_API_KEY, o envio do feedback continua funcionando e apenas registra
# um aviso — nenhum e-mail é enviado. Crie uma chave em https://resend.com.
RESEND_API_KEY=re_...
# Destinatário do aviso (padrão: ivan.neun@gmail.com).
FEEDBACK_EMAIL_TO=ivan.neun@gmail.com
# Remetente. O padrão onboarding@resend.dev só entrega para o e-mail do dono da
# conta Resend; para outros destinatários, use um domínio verificado.
FEEDBACK_EMAIL_FROM=onboarding@resend.dev
