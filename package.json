{
  "name": "hibi-no-ichibun",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/deploy-ingest.mjs; tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "db:up": "docker compose up -d",
